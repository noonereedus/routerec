Bootstrap: docker
From: nvcr.io/nvidia/pytorch:24.10-py3

%labels
Author vlad
Version v0.1
Description "Baseline eval environment for BlueBear"

%setup
    mkdir -p ${APPTAINER_ROOTFS}/rds
    mkdir -p ${APPTAINER_ROOTFS}/scratch
    mkdir -p ${APPTAINER_ROOTFS}/castles
    mkdir -p ${APPTAINER_ROOTFS}/home
    mkdir -p ${APPTAINER_ROOTFS}/tmp
    mkdir -p ${APPTAINER_ROOTFS}/bear-apps
    mkdir -p ${APPTAINER_ROOTFS}/bask-apps

%environment
export HF_HOME=/rds/projects/f/fengyv-kaiji/vxk276/hf_cache
export HF_DATASETS_CACHE=${HF_HOME}/hd
export HF_HUB_CACHE=${HF_HOME}/hub
export TRANSFORMERS_CACHE=${HF_HOME}/transformers
export PYTHONUNBUFFERED=1

%post
    set -e

    apt-get update && \
    apt-get install -y --no-install-recommends \
        git curl ca-certificates \
        build-essential cmake ninja-build pkg-config && \
    rm -rf /var/lib/apt/lists/*

    python -m pip install --upgrade pip setuptools wheel

    # torch/torchvision intentionally excluded — already in base image
    python -m pip install \
        numpy scipy pandas scikit-learn tqdm pyyaml \
        huggingface_hub datasets transformers accelerate \
        sentence-transformers

%runscript
exec "$@"